oudi (автобус №30).", "places": ["garden", "dasoudi"]}, {"date": "2026-08-26", "mode": "work", "title": "☕ Старый город", "text": "Лёгкий день по центру: старый город, сувениры, кофейни. Вечером — ужин в старом городе.", "places": ["castle", "garden"]}, {"date": "2026-08-27", "mode": "car", "title": "💎 Айя-Напа · лучшая вода", "text": "Каво Греко (морские пещеры, кристальная вода) и знаменитый Nissi Beach. Выезжать пораньше.", "places": ["cavo", "nissi"]}, {"date": "2026-08-28", "mode": "car", "title": "✈️ Отъезд · через Ларнаку", "text": "Вылет из Ларнаки в <b>18:40</b>. Утро свободно, выезд ~14:00. По пути — Хала Султан или Финикудес.", "places": ["hala", "finikoudes"]}]}, "BASE": {"name": "Закаки, Dimitri Hatzi 6", "q": "Dimitri Hatzi 6, Zakaki, Limassol"}};

const $ = (s,r=document)=>r.querySelector(s);
const MONTHS=['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'];
const DOW=['Вс','Пн','Вт','Ср','Чт','Пт','Сб'];
function iso(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function parseD(s){const p=s.split('-');return new Date(+p[0],+p[1]-1,+p[2]);}
function fmtShort(s){const d=parseD(s);return d.getDate()+' '+MONTHS[d.getMonth()];}
function dow(s){return DOW[parseD(s).getDay()];}
function dirlink(p){return 'https://www.google.com/maps/dir/?api=1&destination='+p[2]+','+p[3]+'&destination_place_id='+p[4];}
function stars(r){let f=Math.floor(r),h=(r-f)>=0.5;return '★'.repeat(f)+(h?'½':'');}
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

// storage
let GUESTS=[];
function load(){
  try{const raw=localStorage.getItem('cyprus_guests');if(raw){GUESTS=JSON.parse(raw);}}catch(e){}
  if(!GUESTS.length){GUESTS=[JSON.parse(JSON.stringify(DATA.SEED))];}
  // ensure seed present
  if(!GUESTS.find(g=>g.id==='seed-ira-stas')){GUESTS.unshift(JSON.parse(JSON.stringify(DATA.SEED)));}
}
function save(){try{localStorage.setItem('cyprus_guests',JSON.stringify(GUESTS));}catch(e){}}

let active=0;

function buildPlan(g){
  if(g.custom) return g.days;
  const start=parseD(g.arrive),end=parseD(g.depart),days=[];
  const dates=[];for(let d=new Date(start);d<=end;d.setDate(d.getDate()+1))dates.push(new Date(d));
  const cd=new Set(g.carDates||[]);let ci=0,wi=0;
  dates.forEach((dt,i)=>{
    const ds=iso(dt);let tpl,mode;
    if(i===0){tpl=DATA.ARRIVAL;mode='car';}
    else if(i===dates.length-1){tpl=DATA.DEPARTURE;mode='car';}
    else if(cd.has(ds)){tpl=DATA.CARPOOL[ci%DATA.CARPOOL.length];ci++;mode='car';}
    else{tpl=DATA.WORKPOOL[wi%DATA.WORKPOOL.length];wi++;mode='work';}
    days.push({date:ds,mode:mode,title:tpl.title,text:tpl.text,places:tpl.places});
  });
  return days;
}

function placeCard(key){
  const p=DATA.PLACES[key];if(!p)return'';
  return '<div class="pc"><div class="pc-img" style="background-image:url(\''+p[5]+'\')"></div>'
    +'<div class="pc-body"><div class="pc-top"><span class="pc-name">'+esc(p[0])+'</span>'
    +'<span class="rat">'+stars(p[1])+' '+p[1]+'</span></div>'
    +'<p class="pc-tip">'+esc(p[6])+'</p>'
    +'<a class="route" href="'+dirlink(p)+'" target="_blank" rel="noopener">📍 Построить маршрут</a></div></div>';
}

function render(){
  const g=GUESTS[active];const days=buildPlan(g);
  // tabs
  let tabs='';GUESTS.forEach((gg,i)=>{
    const del=gg.id==='seed-ira-stas'?'':'<span class="del" data-del="'+i+'">✕</span>';
    tabs+='<div class="tab'+(i===active?' active':'')+'" data-tab="'+i+'">'+esc(gg.name)+del+'</div>';
  });
  tabs+='<div class="tab-add" id="addBtn">＋ Новые гости</div>';
  $('#tabs').innerHTML=tabs;
  // header dates
  const range=days.length?fmtShort(days[0].date)+' – '+fmtShort(days[days.length-1].date):'';
  $('#planTitle').innerHTML='🗓️ План: '+esc(g.name)+' <span style="font-weight:600;color:#8a9aa1;font-size:15px">· '+range+' · '+days.length+' дн.</span>';
  // overview
  let ov='';days.forEach((d,i)=>{
    ov+='<div class="ov-chip '+d.mode+'" data-go="day'+i+'">'
      +'<div class="ov-d">Д'+(i+1)+' · '+fmtShort(d.date)+' '+dow(d.date)+'</div>'
      +'<div class="ov-t">'+esc(d.title)+'</div>'
      +'<div class="ov-badge '+d.mode+'">'+(d.mode==='car'?'🚗 машина':'🚶🚌 пешком')+'</div></div>';
  });
  $('#overview').innerHTML=ov;
  // days
  let dh='';days.forEach((d,i)=>{
    const badge=d.mode==='car'?'<span class="badge car">🚗 машина · хозяин свободен</span>':'<span class="badge work">🚶🚌 пешком + автобус</span>';
    const cards=d.places.map(placeCard).join('');
    dh+='<div class="day '+d.mode+'" id="day'+i+'"><div class="day-head">'
      +'<span class="daynum">Д'+(i+1)+'</span><div class="day-titles">'
      +'<div class="date">'+fmtShort(d.date)+' · '+dow(d.date)+'</div>'
      +'<div class="dtitle">'+esc(d.title)+'</div></div>'+badge+'</div>'
      +'<p class="day-text">'+d.text+'</p><div class="cards">'+cards+'</div></div>';
  });
  $('#days').innerHTML=dh;
  bind();
}

function bind(){
  document.querySelectorAll('[data-tab]').forEach(el=>el.onclick=e=>{
    if(e.target.dataset.del!==undefined)return;active=+el.dataset.tab;render();window.scrollTo({top:0,behavior:'smooth'});});
  document.querySelectorAll('[data-del]').forEach(el=>el.onclick=e=>{
    e.stopPropagation();const i=+el.dataset.del;
    if(confirm('Удалить гостей «'+GUESTS[i].name+'»?')){GUESTS.splice(i,1);active=0;save();render();}});
  document.querySelectorAll('[data-go]').forEach(el=>el.onclick=()=>{
    const t=document.getElementById(el.dataset.go);if(t)t.scrollIntoView({behavior:'smooth'});});
  const ab=$('#addBtn');if(ab)ab.onclick=openModal;
}

// ---- add guest modal ----
function openModal(){
  $('#overlay').classList.add('on');
  $('#modal').innerHTML=''
   +'<h3>Новые гости</h3><p class="hint">Введите имена и даты — план соберётся сам. Потом отметите, в какие дни есть машина.</p>'
   +'<div class="field"><label>Имена гостей</label><input id="mName" placeholder="например: Мама и папа"></div>'
   +'<div class="field"><label>Прилёт</label><input id="mArr" type="date"></div>'
   +'<div class="field"><label>Вылет</label><input id="mDep" type="date"></div>'
   +'<div class="btns"><button class="btn ghost" onclick="closeModal()">Отмена</button>'
   +'<button class="btn primary" onclick="stepDays()">Далее →</button></div>';
}
function closeModal(){$('#overlay').classList.remove('on');}
function stepDays(){
  const name=$('#mName').value.trim()||'Гости';
  const a=$('#mArr').value,b=$('#mDep').value;
  if(!a||!b||parseD(b)<parseD(a)){alert('Проверьте даты: вылет должен быть не раньше прилёта.');return;}
  const dates=[];for(let d=parseD(a);d<=parseD(b);d.setDate(d.getDate()+1))dates.push(iso(d));
  let rows='';dates.forEach((ds,i)=>{
    const first=i===0,last=i===dates.length-1;
    const label='Д'+(i+1)+' · '+fmtShort(ds)+' '+dow(ds);
    if(first||last){
      rows+='<div class="dayrow"><span class="dl">'+label+'</span><span class="toggle car fixed">'+(first?'✈️ приезд':'✈️ отъезд')+'</span></div>';
    }else{
      rows+='<div class="dayrow"><span class="dl">'+label+'</span>'
        +'<button class="toggle work" data-date="'+ds+'" onclick="tog(this)">🚶🚌 пешком</button></div>';
    }
  });
  $('#modal').innerHTML='<h3>'+esc(name)+'</h3><p class="hint">Отметьте дни, когда будет машина (свободный день хозяина) — в них попадут поездки по острову. Остальные — пешие прогулки по Лимассолу.</p>'
    +'<div style="max-height:44vh;overflow-y:auto;margin:4px 0">'+rows+'</div>'
    +'<div class="btns"><button class="btn ghost" onclick="openModal()">← Назад</button>'
    +'<button class="btn primary" onclick="createGuest(\''+encodeURIComponent(name)+'\',\''+a+'\',\''+b+'\')">🎉 Построить план</button></div>'
    +'<div class="save-note">План сохранится в этом браузере</div>';
}
function tog(b){
  if(b.classList.contains('work')){b.classList.remove('work');b.classList.add('car');b.textContent='🚗 машина';}
  else{b.classList.remove('car');b.classList.add('work');b.textContent='🚶🚌 пешком';}
}
function createGuest(nameEnc,a,b){
  const name=decodeURIComponent(nameEnc);
  const carDates=[...document.querySelectorAll('.toggle.car[data-date]')].map(x=>x.dataset.date);
  const g={id:'g'+Date.now(),name:name,custom:false,arrive:a,depart:b,carDates:carDates};
  GUESTS.push(g);active=GUESTS.length-1;save();closeModal();render();window.scrollTo({top:0,behavior:'smooth'});
}
window.closeModal=closeModal;window.stepDays=stepDays;window.tog=tog;window.createGuest=createGuest;window.openModal=openModal;

// static sections
function renderStatic(){
  // restaurants
  let rh='';DATA.RESTOS.forEach(r=>{
    const price='€'.repeat(r[6]);const rus=r[7]?'<span class="chip rus">🗣️ русский</span>':'';
    rh+='<div class="rc"><div class="rc-img" style="background-image:url(\''+r[5]+'\')"><span class="rc-rat">'+r[1]+' ★</span></div>'
      +'<div class="rc-body"><div class="rc-name">'+esc(r[0])+'</div>'
      +'<div class="chips"><span class="chip price">'+price+'</span>'+rus+'</div>'
      +'<p class="rc-note">'+esc(r[8])+'</p>'
      +'<a class="route" style="font-size:12px;padding:6px 12px" href="https://www.google.com/maps/dir/?api=1&destination='+r[2]+','+r[3]+'&destination_place_id='+r[4]+'" target="_blank">📍 Маршрут</a></div></div>';
  });
  $('#restos').innerHTML=rh;
  let bh='';DATA.BEACHES.forEach(k=>bh+=placeCard(k));
  $('#beaches').innerHTML=bh;
}

load();render();renderStatic();
</script>
